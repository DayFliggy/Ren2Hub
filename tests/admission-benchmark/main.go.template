var ErrGatewayWaitExpired = errors.New("wait expired")
var ErrGatewayQueueFull = errors.New("queue full")

type GatewayWaitBudget struct{ remaining time.Duration }

func (b *GatewayWaitBudget) Remaining() time.Duration { return b.remaining }
func (b *GatewayWaitBudget) consume(d time.Duration)  { b.remaining -= d }

type counter struct {
	active, waitMS             atomic.Int64
	entered, completed, failed atomic.Uint64
}

func gatewayQueueCounter(string) *counter { return nil }

type commandCounter struct{ commands atomic.Int64 }

func (h *commandCounter) BeforeProcess(ctx context.Context, _ redis.Cmder) (context.Context, error) {
	h.commands.Add(1)
	return ctx, nil
}
func (h *commandCounter) AfterProcess(context.Context, redis.Cmder) error { return nil }
func (h *commandCounter) BeforeProcessPipeline(ctx context.Context, cmds []redis.Cmder) (context.Context, error) {
	h.commands.Add(int64(len(cmds)))
	return ctx, nil
}
func (h *commandCounter) AfterProcessPipeline(context.Context, []redis.Cmder) error { return nil }
func cpuMS() float64 {
	var created, exited, kernel, user windows.Filetime
	if err := windows.GetProcessTimes(windows.CurrentProcess(), &created, &exited, &kernel, &user); err != nil {
		panic(err)
	}
	kernelTicks := uint64(kernel.HighDateTime)<<32 | uint64(kernel.LowDateTime)
	userTicks := uint64(user.HighDateTime)<<32 | uint64(user.LowDateTime)
	return float64(kernelTicks+userTicks) / 10000
}
func redisCPU(client *redis.Client) float64 {
	info, err := client.Info(context.Background(), "cpu").Result()
	if err != nil {
		panic(err)
	}
	var total float64
	for _, line := range strings.Split(info, "\n") {
		if strings.HasPrefix(line, "used_cpu_user:") || strings.HasPrefix(line, "used_cpu_sys:") {
			var v float64
			_, err = fmt.Sscanf(strings.SplitN(line, ":", 2)[1], "%f", &v)
			if err != nil {
				panic(err)
			}
			total += v
		}
	}
	return total * 1000
}

type result struct {
	Backend        string  `json:"backend"`
	Scenario       string  `json:"scenario"`
	Round          int     `json:"round"`
	Requests       int     `json:"requests"`
	Success        int     `json:"success"`
	Rejected       int     `json:"rejected"`
	TimedOut       int     `json:"timed_out"`
	AdmissionP50MS float64 `json:"admission_p50_ms"`
	AdmissionP95MS float64 `json:"admission_p95_ms"`
	WallMS         float64 `json:"wall_ms"`
	CPU            float64 `json:"gateway_cpu_ms"`
	RedisCPU       float64 `json:"redis_cpu_ms"`
	RedisCommands  int64   `json:"redis_commands"`
	AllocBytes     uint64  `json:"allocated_bytes"`
	HeapBytes      uint64  `json:"heap_bytes"`
}

func main() {
	address := os.Getenv("ADMISSION_BENCHMARK_REDIS_ADDR")
	host, _, err := net.SplitHostPort(address)
	if err != nil || (host != "localhost" && !net.ParseIP(host).IsLoopback()) {
		panic("ADMISSION_BENCHMARK_REDIS_ADDR must name an isolated loopback Redis")
	}
	client := redis.NewClient(&redis.Options{Addr: address, PoolSize: 32})
	defer client.Close()
	hook := &commandCounter{}
	client.AddHook(hook)
	ctx := context.Background()
	if err := client.Ping(ctx).Err(); err != nil {
		panic(err)
	}
	scenarios := []struct {
		name        string
		n, parallel int
		hold        time.Duration
	}{{"low", 80, 1, 5 * time.Millisecond}, {"burst", 80, 16, 5 * time.Millisecond}, {"congestion", 160, 64, 20 * time.Millisecond}}
	var results []result
	for round := 1; round <= 3; round++ {
		for _, s := range scenarios {
			for _, backend := range []string{"redis_previous_core", "local_fifo"} {
				m := service.NewAdmissionManager(1024)
				policy := service.AdmissionPolicy{Capacity: 8, QueueSize: 20}
				resourceKey := fmt.Sprintf("route:lease:v2:benchmark:%d:%s:%s", os.Getpid(), s.name, backend)
				// The only old implementation lives in this ignored, temporary benchmark package.
				acquire := func(id int) (func(), error) {
					if backend == "local_fifo" {
						c, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
						defer cancel()
						p, e := m.Acquire(c, "user:1", policy, true)
						if e != nil {
							return nil, e
						}
						return p.Release, nil
					}
					idText := fmt.Sprintf("bench-%d-%d-%s-%d", os.Getpid(), round, s.name, id)
					l, e := AcquireQueuedRouteLease(ctx, client, idText, idText, 120*time.Second, RouteLeaseResource{Key: resourceKey, Capacity: 8}, 20, &GatewayWaitBudget{100 * time.Millisecond})
					if e != nil {
						return nil, e
					}
					return func() {
						if err := ReleaseRouteLease(ctx, client, l); err != nil {
							panic(err)
						}
					}, nil
				}
				release, e := acquire(-1)
				if e != nil {
					panic(e)
				}
				release()
				runtime.GC()
				var before, after runtime.MemStats
				runtime.ReadMemStats(&before)
				redisBefore := redisCPU(client)
				cmdBefore := hook.commands.Load()
				cpuBefore := cpuMS()
				start := time.Now()
				var mu sync.Mutex
				var latencies []float64
				r := result{Backend: backend, Scenario: s.name, Round: round, Requests: s.n}
				jobs := make(chan int)
				var workers sync.WaitGroup
				for range s.parallel {
					workers.Add(1)
					go func() {
						defer workers.Done()
						for id := range jobs {
							began := time.Now()
							release, e := acquire(id)
							elapsed := float64(time.Since(began).Microseconds()) / 1000
							if e == nil {
								time.Sleep(s.hold)
								release()
							}
							mu.Lock()
							if e == nil {
								r.Success++
								latencies = append(latencies, elapsed)
							} else if errors.Is(e, ErrGatewayWaitExpired) || errors.Is(e, context.DeadlineExceeded) {
								r.TimedOut++
							} else if errors.Is(e, ErrGatewayQueueFull) || errors.Is(e, service.ErrGatewayQueueFull) {
								r.Rejected++
							} else {
								panic(e)
							}
							mu.Unlock()
						}
					}()
				}
				for id := 0; id < s.n; id++ {
					jobs <- id
				}
				close(jobs)
				workers.Wait()
				r.WallMS = float64(time.Since(start).Microseconds()) / 1000
				r.CPU = cpuMS() - cpuBefore
				r.RedisCommands = hook.commands.Load() - cmdBefore
				r.RedisCPU = redisCPU(client) - redisBefore
				runtime.ReadMemStats(&after)
				r.AllocBytes = after.TotalAlloc - before.TotalAlloc
				r.HeapBytes = after.HeapAlloc
				sort.Float64s(latencies)
				if len(latencies) > 0 {
					r.AdmissionP50MS = latencies[(len(latencies)-1)/2]
					r.AdmissionP95MS = latencies[(len(latencies)-1)*95/100]
				}
				if r.Success+r.Rejected+r.TimedOut != s.n {
					panic("request conservation")
				}
				if backend == "local_fifo" {
					state := m.Metrics()
					if state.InFlight != 0 || state.Queued != 0 || state.Granted != state.Released || r.RedisCommands != 0 {
						panic("local conservation or Redis regression")
					}
				}
				keys := []string{resourceKey, resourceKey + ":queue", resourceKey + ":queue_expiry", resourceKey + ":sequence"}
				if err := client.Unlink(ctx, keys...).Err(); err != nil {
					panic(err)
				}
				results = append(results, r)
			}
		}
	}
	bytes, err := common.Marshal(results)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(bytes))
}
