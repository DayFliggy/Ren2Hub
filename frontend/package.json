{
  "name": "ren2hub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "python3 -B ../scripts/testing/run.py browser"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "acorn": "8.17.0",
    "axios": "1.20.0",
    "echarts": "^6.1.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "18.0.5",
    "pinia": "^4.0.2",
    "qrcode.vue": "3.11.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
  }
}
